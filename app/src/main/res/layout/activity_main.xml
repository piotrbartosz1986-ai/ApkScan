<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/cameraShell"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:background="#000000">

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="performance"
                app:scaleType="fillCenter" />

            <com.bricolab.scannerbridge.ScanOverlayView
                android:id="@+id/scanOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <Button
            android:id="@+id/cameraScanToggle"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cameraTorchToggle"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="90dp"
            android:layout_marginBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🔦"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />

        <SeekBar
            android:id="@+id/zoomSeek"
            android:layout_width="190dp"
            android:layout_height="64dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="-59dp"
            android:max="1000"
            android:progress="0"
            android:rotation="-90"
            android:splitTrack="false"
            android:thumb="@drawable/zoom_thumb_round" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="50dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_zoom_label"
            android:gravity="center"
            android:text="1.0×"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg" />

</LinearLayout>
